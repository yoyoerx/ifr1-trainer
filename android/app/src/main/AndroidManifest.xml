<?xml version="1.0" encoding="utf-8"?>
<!--
UNVERIFIED SCAFFOLD - see android/README.md. USB-host support now declared
per the §3.1 spike result (docs/ANDROID_PORT_PLAN.md, "Spike result
2026-09-25"): the IFR-1 needs UsbHidInput's raw UsbManager/
UsbDeviceConnection path (a forced interface claim, detaching the kernel's
usbhid driver) rather than the free InputDevice/KeyEvent path, because the
inner knob produces no evdev events at all under the kernel's default HID
translation. `required="true"` because IFR-1 support is required for v1
(§7 decision) - this app has no useful touch-only fallback yet (§3.2).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.OctaviIfrTrainer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <!-- landscape hardcoded for Phase 1 (§6) - portrait is its own
                 later phase (§6 Phase 2 / §3.3), not toggled here yet -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- launch straight into the app (and auto-grant USB permission,
                 no dialog) when the IFR-1 is plugged in with the app not
                 already running - the common real-world case (phone mounted,
                 IFR-1 connected via the OTG adapter before/at session start) -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>
</manifest>
